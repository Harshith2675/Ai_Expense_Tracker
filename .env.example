# ====================================================================
# FinPulse Expense Tracker — Environment Configuration
# ====================================================================

# 1. Supabase Project Credentials
# Obtain these from your Supabase Dashboard: Project Settings -> API
# NOTE: Only the PUBLIC URL and PUBLISHABLE ANON KEY must be used in frontend client.
# NEVER expose the SERVICE_ROLE_KEY or database passwords in the frontend!

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Local Development Server Port
PORT=8787

# 3. Application Defaults
DEFAULT_CURRENCY=INR
DEFAULT_THEME=system
DEFAULT_MONTHLY_BUDGET=50000
