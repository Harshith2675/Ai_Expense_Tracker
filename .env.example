# =============================================================================
# AI Expense Tracker — Root Environment Variable Reference
# =============================================================================
# Copy this template to create your local .env files.
# Never commit actual .env files, API tokens, or secrets to Git.

# -----------------------------------------------------------------------------
# Backend Environment Variables (Render / Flask Service)
# -----------------------------------------------------------------------------
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5050

# Database Persistence (Render Persistent Disk mount or SQLite path)
DATABASE_PATH=instance/expense_tracker.sqlite
# Example with Render Disk mounted at /var/data:
# DATABASE_PATH=/var/data/expense_tracker.sqlite

# Security & Secrets
SECRET_KEY=generate-a-secure-random-32-byte-secret-key

# CORS Whitelist (Set to your exact deployed Vercel domain, no trailing slash)
CORS_ALLOWED_ORIGINS=https://your-expense-tracker.vercel.app
FRONTEND_URL=https://your-expense-tracker.vercel.app

# Optional Managed PostgreSQL for production
# DATABASE_URL=postgresql://username:password@host:port/database_name

# Bank API Integration (Plaid)
BANKING_PROVIDER=demo
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_key_here
PLAID_ACCESS_TOKEN=access-sandbox-your-token-here
PLAID_ENV=sandbox

# -----------------------------------------------------------------------------
# Frontend Environment Variables (Vercel / React + Vite Client)
# -----------------------------------------------------------------------------
# Backend API Base URL (Must be set in Vercel project environment variables)
VITE_API_BASE_URL=https://your-flask-backend.onrender.com/api
VITE_API_TIMEOUT_MS=12000
