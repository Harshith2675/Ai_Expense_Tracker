# Production Backend API Base URL
# Do not hardcode a production URL in the codebase.
# For local development with Flask on port 5050:
# VITE_API_BASE_URL=http://localhost:5050/api
# For production on Vercel:
# Set this in your Vercel project Environment Variables dashboard:
VITE_API_BASE_URL=https://your-flask-backend.onrender.com/api

# Optional: API request timeout in milliseconds (defaults to 12000 to accommodate cold starts)
VITE_API_TIMEOUT_MS=12000
