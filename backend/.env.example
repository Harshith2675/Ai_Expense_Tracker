# Flask Application Environment
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5050

# Database Configuration
# Local SQLite default:
DATABASE_PATH=instance/expense_tracker.sqlite
# Production with Render Persistent Disk (e.g. mounted at /var/data):
# DATABASE_PATH=/var/data/expense_tracker.sqlite
# Optional PostgreSQL URL for production migration or managed PostgreSQL:
# DATABASE_URL=postgresql://username:password@host:port/database_name

# Application Security
# Set a strong, randomly generated string in production (e.g., `openssl rand -hex 32`)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# CORS Allowed Origins
# Set to the exact URL of your deployed frontend without trailing slash
# For multiple domains, separate by comma (e.g. https://app.vercel.app,https://myexpenses.com)
CORS_ALLOWED_ORIGINS=https://your-frontend-app.vercel.app
FRONTEND_URL=https://your-frontend-app.vercel.app

# ─────────────────────────────────────────────────────────────
# Automatic Financial Detection Provider Configuration
# ─────────────────────────────────────────────────────────────
# BANKING_PROVIDER: 'demo' (default), 'plaid', or 'disconnected'
BANKING_PROVIDER=demo

# Plaid Open Banking API Credentials (Required ONLY if BANKING_PROVIDER=plaid)
# Obtain these from your Plaid Developer Dashboard (https://dashboard.plaid.com/)
# NOTE: Never store actual bank passwords, PINs, or user credentials here.
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_key_here
PLAID_ACCESS_TOKEN=access-sandbox-your-token-here
PLAID_ENV=sandbox
